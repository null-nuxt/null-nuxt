{
  "name": "null-nuxt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r prepack",
    "test": "pnpm -r test",
