{
  "name": "@null-nuxt/forms",
  "version": "0.1.0",
  "description": "Formulário declarado em contextos — campos, schema e regras — consumido por composables, no estilo defineStore.",
  "license": "MIT",
  "homepage": "https://github.com/null-nuxt/null-nuxt/tree/main/packages/forms#readme",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "forms",
    "validation",
    "standard-schema",
    "zod",
    "valibot",
    "yup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/null-nuxt/null-nuxt.git",
    "directory": "packages/forms"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:playground": "cd playground && vue-tsc --build --force",
    "test": "vitest run",
    "prepare": "nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "^3.17.0 || ^4.0.0",
    "@nuxt/schema": "^3.17.0 || ^4.0.0",
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "nuxt": ">=3.13.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.1",
    "@types/node": "^26.1.2",
    "nuxt": "^4.4.8",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.31",
    "vue-tsc": "^3.3.8",
    "yup": "^1.7.1"
  }
}
